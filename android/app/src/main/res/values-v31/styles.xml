<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 안드로이드 12 부터는 시작 화면을 앱이 마음대로 못 그린다.
     시스템이 「바탕색 한 가지 + 가운데 동그란 아이콘」 만 그린다.
     전체 그림(@drawable/splash)은 안드로이드 11 이하에서만 쓰인다.
     그래서 여기서 바탕색과 가운데 그림을 우리 것으로 맞춘다 —
     바탕은 아이콘 하늘색, 가운데는 배만 오려낸 그림. 앱 바탕과 이어져 보인다. -->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splashBg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
